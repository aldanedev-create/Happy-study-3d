          "questions": [
            {
              "id": "ss-fam-q1",
              "question": "Mother, father, and children is:",
              "options": ["Nuclear family", "Extended family", "Single-parent", "Blended"],
              "correctAnswer": "Nuclear family",
              "explanation": "Parents and children only",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Caribbean family structures",
            "Family changes"
          ],
          "resources": []
        }
      ]
