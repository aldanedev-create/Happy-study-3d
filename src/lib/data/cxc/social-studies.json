    {
      "id": "individual-society",
      "title": "Individual and Society",
      "description": "Understanding how individuals relate to society",
      "importance": "must-know",
      "difficulty": "beginner",
      "learningObjectives": [
        "Understand individual-society relationship",
        "Identify social groups",
        "Recognize social roles"
      ],
      "topics": [
        {
          "id": "individual-society",
          "title": "Individual and Society",
          "summary": "How individuals function within society",
          "mustKnow": [
            "Society = group of people living together",
            "Individuals have roles and responsibilities",
            "Social groups: family, school, church, peers",
            "Social norms guide behavior",
            "Individuals contribute to society"
          ],
          "keyTerms": [
            {"term": "Society", "definition": "Group of people living together with shared culture"},
            {"term": "Social Role", "definition": "Expected behavior for a position"},
            {"term": "Social Norm", "definition": "Accepted behavior in society"},
            {"term": "Social Group", "definition": "People who interact and share identity"}
          ],
          "examples": [
            {
              "question": "What is your role as a student?",
              "answer": "Attend classes, study, follow school rules",
              "explanation": "Social roles have expected behaviors"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Confusing society with government",
            "Not understanding social roles"
          ],
          "examTips": [
            "Give examples of social groups",
            "Explain individual responsibilities"
          ],
          "questions": [
            {
              "id": "ss-q1",
              "question": "Society is best defined as:",
              "options": ["Group living together with shared culture", "Government only", "Buildings and roads", "Laws only"],
              "correctAnswer": "Group living together with shared culture",
              "explanation": "Society includes people, culture, and interactions",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Social structure",
            "Community development"
          ],
          "resources": []
        }
      ]
    },
    {
      "id": "family",
