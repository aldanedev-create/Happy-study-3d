    {
      "id": "accounting-equation",
      "title": "Accounting Equation",
      "description": "Foundation of double-entry accounting",
      "importance": "must-know",
      "difficulty": "beginner",
      "learningObjectives": [
        "Understand the accounting equation",
        "Apply to transactions"
      ],
      "topics": [
        {
          "id": "the-equation",
          "title": "The Accounting Equation",
          "summary": "Assets = Liabilities + Owner's Equity",
          "mustKnow": [
            "Assets = Liabilities + Owner's Equity",
            "Assets: resources owned (cash, inventory, equipment)",
            "Liabilities: debts owed (loans, payables)",
            "Owner's Equity: owner's investment + profits - drawings",
            "Every transaction affects at least two accounts"
          ],
          "keyTerms": [
            {"term": "Asset", "definition": "Resource owned by business"},
            {"term": "Liability", "definition": "Debt owed by business"},
            {"term": "Owner's Equity", "definition": "Owner's stake in business"},
            {"term": "Transaction", "definition": "Business activity affecting finances"}
          ],
          "examples": [
            {
              "question": "Assets $10,000, Liabilities $4,000. Find Owner's Equity",
              "answer": "$6,000",
              "explanation": "OE = A - L = 10,000 - 4,000 = 6,000"
            },
            {
              "question": "Buy equipment for cash. Effect on equation?",
              "answer": "One asset up (equipment), one asset down (cash)",
              "explanation": "Total assets unchanged"
            }
          ],
          "formulas": [
            "Assets = Liabilities + Owner's Equity",
            "Owner's Equity = Assets - Liabilities"
          ],
          "commonMistakes": [
            "Wrong classification of accounts",
            "Not balancing equation"
          ],
          "examTips": [
            "Always check equation balances",
            "Classify accounts carefully"
          ],
          "questions": [
            {
              "id": "poa-eq-q1",
              "question": "Assets $15,000, OE $9,000. Liabilities?",
              "options": ["$6,000", "$24,000", "$9,000", "$15,000"],
              "correctAnswer": "$6,000",
              "explanation": "L = A - OE = 15,000 - 9,000 = 6,000",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Balance sheet preparation",
            "Financial analysis"
          ],
          "resources": []
        }
      ]
    },
    {
      "id": "double-entry",
      "title": "Double Entry",
      "description": "Recording transactions with debits and credits",
      "importance": "must-know",
      "difficulty": "intermediate",
      "learningObjectives": [
        "Understand debit and credit rules",
        "Record transactions"
      ],
      "topics": [
        {
          "id": "debit-credit",
          "title": "Debit and Credit Rules",
          "summary": "Every transaction has equal debits and credits",
          "mustKnow": [
            "Debit = left side, Credit = right side",
            "Assets increase with debit",
            "Liabilities increase with credit",
            "OE increases with credit",
            "Debits must equal credits"
          ],
          "keyTerms": [
            {"term": "Debit", "definition": "Left side of account"},
            {"term": "Credit", "definition": "Right side of account"},
            {"term": "Double Entry", "definition": "Recording both sides of transaction"}
          ],
          "examples": [
            {
              "question": "Buy equipment $500 cash. Journal entry?",
              "answer": "Debit Equipment $500, Credit Cash $500",
              "explanation": "Equipment up (debit), Cash down (credit)"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Wrong debit/credit side",
            "Not balancing entries"
          ],
          "examTips": [
            "Remember: DEAD CLIC (Debit Expenses Assets Drawings, Credit Liabilities Income Capital)",
            "Check debits = credits"
          ],
          "questions": [
            {
              "id": "poa-de-q1",
              "question": "Cash sale of goods. Debit what?",
              "options": ["Cash", "Sales", "Inventory", "Capital"],
              "correctAnswer": "Cash",
              "explanation": "Cash increases = debit cash",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Journal entries",
            "Ledger accounts"
          ],
          "resources": []
        }
      ]
    },
