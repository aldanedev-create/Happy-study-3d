      ],
      "topics": [
        {
          "id": "basic-concepts",
          "title": "Basic Accounting Concepts",
          "summary": "Rules that guide how accounting is done",
          "mustKnow": [
            "Going Concern: business will continue operating",
            "Accruals: record when incurred, not when paid",
            "Consistency: use same methods each year",
            "Prudence: don't overstate profits",
            "Materiality: record significant items only",
            "Business Entity: business separate from owner"
          ],
          "keyTerms": [
            {"term": "Going Concern", "definition": "Business will continue operating"},
            {"term": "Accruals", "definition": "Record when incurred, not when paid"},
            {"term": "Consistency", "definition": "Same methods each year"},
            {"term": "Prudence", "definition": "Don't overstate profits"},
            {"term": "Business Entity", "definition": "Business separate from owner"}
          ],
          "examples": [
            {
              "question": "Owner buys personal car with business money. Which concept?",
              "answer": "Business Entity",
              "explanation": "Business is separate from owner"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Confusing concepts",
            "Not applying concepts correctly"
          ],
          "examTips": [
            "Memorize all concepts",
            "Give examples for each"
          ],
          "questions": [
            {
              "id": "poa-q1",
              "question": "Recording expenses when incurred, not when paid, is:",
              "options": ["Accruals concept", "Going concern", "Consistency", "Materiality"],
              "correctAnswer": "Accruals concept",
              "explanation": "Accruals means record when incurred",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "International Accounting Standards",
            "Accounting ethics"
          ],
          "resources": []
        }
      ]
