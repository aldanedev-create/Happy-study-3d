      "topics": [
        {
          "id": "forms-of-ownership",
          "title": "Forms of Business Ownership",
          "summary": "Different legal structures for businesses",
          "mustKnow": [
            "Sole Trader: one owner, unlimited liability",
            "Partnership: 2-20 owners, share profits",
            "Company: separate legal entity, limited liability",
            "Cooperative: owned by members",
            "Limited liability = owners not personally responsible for debts"
          ],
          "keyTerms": [
            {"term": "Sole Trader", "definition": "Business owned by one person"},
            {"term": "Partnership", "definition": "Business owned by 2+ people"},
            {"term": "Limited Liability", "definition": "Owners only lose what they invested"},
            {"term": "Unlimited Liability", "definition": "Owners responsible for all debts"}
          ],
          "examples": [
            {
              "question": "Two lawyers start a firm together. What form?",
              "answer": "Partnership",
              "explanation": "Two owners sharing business"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Confusing liability types",
            "Wrong number of partners"
          ],
          "examTips": [
            "Know advantages AND disadvantages",
            "Compare forms clearly"
          ],
          "questions": [
            {
              "id": "pob-own-q1",
              "question": "Limited liability means:",
              "options": ["Owners only lose investment", "Owners lose everything", "No risk", "Government pays debts"],
              "correctAnswer": "Owners only lose investment",
              "explanation": "Limited liability protects personal assets",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Company registration",
            "Legal structures"
          ],
          "resources": []
        }
      ]
