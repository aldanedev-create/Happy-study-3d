    {
      "id": "business-environment",
      "title": "Business and Its Environment",
      "description": "Understanding what business is and how it operates",
      "importance": "must-know",
      "difficulty": "beginner",
      "learningObjectives": [
        "Define business and its purpose",
        "Identify types of businesses",
        "Understand business environment",
        "Recognize stakeholders"
      ],
      "topics": [
        {
          "id": "what-is-business",
          "title": "What is Business?",
          "summary": "Business is any activity that provides goods or services to satisfy needs and wants for profit",
          "mustKnow": [
            "Business provides goods (tangible) and services (intangible)",
            "Purpose: satisfy consumer needs AND make profit",
            "Goods = physical items (food, clothes)",
            "Services = activities (banking, teaching)",
            "Profit = Revenue - Expenses"
          ],
          "keyTerms": [
            {"term": "Business", "definition": "Organization providing goods/services for profit"},
            {"term": "Goods", "definition": "Tangible products you can touch"},
            {"term": "Services", "definition": "Intangible activities provided"},
            {"term": "Profit", "definition": "Money left after paying expenses"},
            {"term": "Stakeholder", "definition": "Anyone affected by or interested in business"}
          ],
          "examples": [
            {
              "question": "Classify: bakery selling bread",
              "answer": "Goods (bread is tangible)",
              "explanation": "Physical product = goods"
            },
            {
              "question": "Classify: hair salon",
              "answer": "Service (haircut is intangible)",
              "explanation": "Activity performed = service"
            }
          ],
          "formulas": [
            "Profit = Revenue - Expenses",
            "Revenue = Price × Quantity Sold"
          ],
          "commonMistakes": [
            "Confusing goods with services",
            "Forgetting profit motive",
            "Not identifying all stakeholders"
          ],
          "examTips": [
            "Give Caribbean examples",
            "Always mention profit motive",
            "Identify multiple stakeholders"
          ],
          "questions": [
            {
              "id": "pob-q1",
              "question": "Which is a service?",
              "options": ["Haircut", "Bread", "Shoes", "Phone"],
              "correctAnswer": "Haircut",
              "explanation": "Haircut is an activity, not a physical item",
              "difficulty": "easy",
              "type": "multiple-choice"
            },
            {
              "id": "pob-q2",
              "question": "Main purpose of business?",
              "options": ["Provide goods/services for profit", "Pay taxes", "Hire people", "Use resources"],
              "correctAnswer": "Provide goods/services for profit",
              "explanation": "Business exists to satisfy needs and make profit",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Caribbean business environment",
            "Types of economic systems"
          ],
          "resources": []
        },
        {
          "id": "stakeholders",
          "title": "Stakeholders",
          "summary": "Groups with interest in business success",
          "mustKnow": [
            "Owners/Shareholders: want profit",
            "Employees: want fair wages",
            "Customers: want quality products",
            "Government: wants taxes and compliance",
            "Community: wants jobs and no pollution"
          ],
          "keyTerms": [
            {"term": "Stakeholder", "definition": "Person/group with interest in business"},
            {"term": "Shareholder", "definition": "Owner of company shares"},
            {"term": "Internal Stakeholder", "definition": "Inside business (owners, employees)"},
            {"term": "External Stakeholder", "definition": "Outside business (government, community)"}
          ],
          "examples": [
            {
              "question": "List stakeholders of a school",
              "answer": "Students, teachers, parents, government, community",
              "explanation": "All affected by or interested in school"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Confusing stakeholders with shareholders only",
            "Missing external stakeholders"
          ],
          "examTips": [
            "Identify at least 3 stakeholders",
            "Explain what each wants"
          ],
          "questions": [
            {
              "id": "pob-stake-q1",
              "question": "Which is an external stakeholder?",
              "options": ["Government", "Manager", "Employee", "Owner"],
              "correctAnswer": "Government",
              "explanation": "Government is outside the business",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Stakeholder conflict",
            "Corporate governance"
          ],
          "resources": []
        }
      ]
    },
