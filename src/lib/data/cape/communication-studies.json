  "units": [
    {
      "id": "communication-basics",
      "title": "Communication",
      "description": "Understanding communication fundamentals",
      "importance": "must-know",
      "difficulty": "beginner",
      "learningObjectives": [
        "Define communication",
        "Understand communication types",
        "Identify communication elements"
      ],
      "topics": [
        {
          "id": "what-is-communication",
          "title": "What is Communication?",
          "summary": "The process of sharing meaning",
          "mustKnow": [
            "Communication: process of sharing meaning",
            "Sender: person sending message",
            "Receiver: person receiving message",
            "Message: information being shared",
            "Channel: medium of transmission",
            "Feedback: receiver's response",
            "Noise: interference with message"
          ],
          "keyTerms": [
            {"term": "Communication", "definition": "Process of sharing meaning"},
            {"term": "Sender", "definition": "Person sending message"},
            {"term": "Receiver", "definition": "Person receiving message"},
            {"term": "Channel", "definition": "Medium of transmission"},
            {"term": "Feedback", "definition": "Receiver's response"},
            {"term": "Noise", "definition": "Interference with message"}
          ],
          "examples": [
            {
              "question": "Teacher explains lesson to students. Who is sender?",
              "answer": "Teacher",
              "explanation": "Teacher sends the message"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Missing feedback element",
            "Ignoring noise"
          ],
          "examTips": [
            "Know all communication elements",
            "Explain the process"
          ],
          "questions": [
            {
              "id": "comm-q1",
              "question": "Response from receiver is:",
              "options": ["Feedback", "Noise", "Channel", "Message"],
              "correctAnswer": "Feedback",
              "explanation": "Feedback is receiver's response",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Communication models",
            "Communication theory"
          ],
          "resources": []
        },
        {
          "id": "communication-process",
          "title": "Communication Process",
          "summary": "How communication works",
          "mustKnow": [
            "Process: sender → message → channel → receiver → feedback",
            "Encoding: putting thoughts into words",
            "Decoding: interpreting the message",
            "Context: situation of communication",
            "Barriers: obstacles to communication",
            "Effective communication: message understood correctly"
          ],
          "keyTerms": [
            {"term": "Encoding", "definition": "Putting thoughts into words"},
            {"term": "Decoding", "definition": "Interpreting the message"},
            {"term": "Context", "definition": "Situation of communication"},
            {"term": "Barrier", "definition": "Obstacle to communication"}
          ],
          "examples": [
            {
              "question": "Putting thoughts into words is?",
              "answer": "Encoding",
              "explanation": "Encoding converts thoughts to words"
            }
          ],
          "formulas": [],
          "commonMistakes": [
            "Confusing encoding and decoding",
            "Missing barriers"
          ],
          "examTips": [
            "Know the process",
            "Identify barriers"
          ],
          "questions": [
            {
              "id": "comm-proc-q1",
              "question": "Interpreting a message is:",
              "options": ["Decoding", "Encoding", "Channeling", "Feedback"],
              "correctAnswer": "Decoding",
              "explanation": "Decoding interprets message",
              "difficulty": "easy",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Shannon-Weaver model",
            "Transactional model"
          ],
          "resources": []
        }
      ]
