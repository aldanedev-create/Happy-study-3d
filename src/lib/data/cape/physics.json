            {"term": "Impulse", "definition": "Change in momentum"},
            {"term": "Conservation", "definition": "Momentum is conserved"}
          ],
          "examples": [
            {
              "question": "2 kg ball moving at 3 m/s. Momentum?",
              "answer": "6 kg m/s",
              "explanation": "p = mv = 2 × 3 = 6"
            }
          ],
          "formulas": [
            "p = mv",
            "Impulse = Ft = Δp"
          ],
          "commonMistakes": [
