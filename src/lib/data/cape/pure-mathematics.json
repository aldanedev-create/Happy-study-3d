            {
              "question": "Solve: x² + 2x - 3 > 0",
              "answer": "x < -3 or x > 1",
              "explanation": "(x+3)(x-1) > 0"
            }
          ],
          "formulas": [
            "Quadratic formula: x = [-b ± √(b²-4ac)]/2a",
            "Discriminant: Δ = b²-4ac"
          ],
          "commonMistakes": [
