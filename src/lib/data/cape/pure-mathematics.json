            {"term": "Inequality", "definition": "Mathematical comparison"}
          ],
          "examples": [
            {
              "question": "Solve: x² - 5x + 6 = 0",
              "answer": "x = 2 or x = 3",
              "explanation": "(x-2)(x-3) = 0"
