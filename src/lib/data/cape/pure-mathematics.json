        {
          "id": "algebra",
          "title": "Algebra",
          "summary": "Advanced algebraic operations and manipulations",
          "mustKnow": [
            "Polynomial operations: addition, subtraction, multiplication, division",
            "Factor theorem: if f(a)=0, then (x-a) is a factor",
            "Remainder theorem: f(a) is remainder when divided by (x-a)",
            "Completing the square: x² + bx = (x + b/2)² - (b/2)²",
            "Partial fractions: decomposition of rational expressions",
            "Binomial theorem: (a+b)ⁿ expansion",
            "Sigma notation: summation of series"
          ],
          "keyTerms": [
            {"term": "Polynomial", "definition": "Expression with multiple terms"},
            {"term": "Factor Theorem", "definition": "If f(a)=0, (x-a) is a factor"},
            {"term": "Remainder Theorem", "definition": "f(a) is remainder"},
            {"term": "Partial Fractions", "definition": "Decomposing rational expressions"},
            {"term": "Binomial Theorem", "definition": "Expansion of (a+b)ⁿ"}
          ],
          "examples": [
            {
              "question": "Use factor theorem to show (x-2) is a factor of f(x)=x³-2x²-x+2",
              "answer": "f(2) = 8-8-2+2 = 0, so (x-2) is a factor",
              "explanation": "Substitute x=2, if result is 0, it's a factor"
            },
            {
              "question": "Complete the square: x² + 6x + 5",
              "answer": "(x+3)² - 4",
              "explanation": "(x+3)² = x²+6x+9, subtract 4 to get +5"
            }
          ],
          "formulas": [
            "Binomial: (a+b)ⁿ = Σ(nCr)aⁿ⁻ʳbʳ",
            "nCr = n!/(r!(n-r)!)"
          ],
          "commonMistakes": [
            "Wrong signs in completing the square",
            "Incorrect factor theorem application",
            "Errors in partial fraction decomposition"
          ],
          "examTips": [
            "Show all workings for full marks",
            "Check answers by substitution",
            "Practice binomial expansion regularly"
          ],
          "questions": [
            {
              "id": "pm-alg-q1",
              "question": "Find the remainder when f(x)=2x³-3x²+4x-5 is divided by (x-1)",
              "options": ["-2", "2", "0", "-4"],
              "correctAnswer": "-2",
              "explanation": "f(1) = 2-3+4-5 = -2",
              "difficulty": "medium",
              "type": "multiple-choice"
            },
            {
              "id": "pm-alg-q2",
              "question": "Expand (2+x)³ using binomial theorem",
              "options": ["8+12x+6x²+x³", "8+6x+12x²+x³", "8+12x+12x²+x³", "8+6x+6x²+x³"],
              "correctAnswer": "8+12x+6x²+x³",
              "explanation": "8+3(4)x+3(2)x²+x³",
              "difficulty": "medium",
              "type": "multiple-choice"
            }
          ],
          "furtherResearch": [
            "Complex numbers",
            "Mathematical induction"
          ],
          "resources": []
