            {"term": "Domain", "definition": "All possible inputs"},
            {"term": "Range", "definition": "All possible outputs"},
            {"term": "Composite", "definition": "Function of a function"},
            {"term": "Inverse", "definition": "Reverses the function"}
          ],
          "examples": [
            {
              "question": "If f(x)=2x+1, find f⁻¹(x)",
              "answer": "f⁻¹(x) = (x-1)/2",
              "explanation": "Swap x and y, solve for y"
            },
            {
              "question": "Find f(g(x)) where f(x)=x² and g(x)=x+1",
              "answer": "f(g(x)) = (x+1)²",
              "explanation": "Substitute g(x) into f(x)"
            }
          ],
          "formulas": [
            "Inverse: swap x and y, solve for y",
            "Composite: f(g(x)) = substitute g into f"
          ],
          "commonMistakes": [
            "Wrong domain and range",
            "Incorrect inverse calculation",
            "Confusing composite order"
          ],
          "examTips": [
            "Always state domain and range",
            "Check inverse by f(f⁻¹(x))=x",
            "Be careful with composite order"
